#!/bin/sh
# Explain an incompatible system in plain words, instead of leaving the user with
# a raw dependency error.
#
# This only helps the `dpkg -i` / double-click route: dpkg unpacks (running this)
# before failing on dependencies, so the message is printed first. `apt install`
# refuses at the solver stage — nothing from the package is ever run — so there is
# no way to be heard there; the README states the requirement up front instead.
#
# Fail-safe by design: it blocks ONLY when Qt is installed and provably older than
# 6.4. If Qt is missing, or the version cannot be read, it says nothing and lets
# dpkg's own dependency handling do its job.
set -e

case "$1" in
    install|upgrade) ;;
    *) exit 0 ;;
esac

QT_MIN=6.4.0
qtver=""
for pkg in libqt6gui6t64 libqt6gui6; do
    v=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || true)
    if [ -n "$v" ]; then qtver="$v"; break; fi
done

[ -n "$qtver" ] || exit 0

if dpkg --compare-versions "$qtver" ge "$QT_MIN" 2>/dev/null; then
    exit 0
fi

cat >&2 <<EOF

  Sorry, Paint.with.me is not compatible with this system.

  It needs Qt ${QT_MIN} or newer. This system has Qt ${qtver}.

  Supported: Ubuntu 24.04+, Kubuntu 24.04+, Debian 12+, Linux Mint 22+, LMDE 6+.
  Ubuntu 22.04 and Linux Mint 21 ship Qt 6.2 and cannot run this build.

  What you can do:
    - Upgrade your distribution, or
    - use the AppImage, which brings its own Qt, or
    - build from source: https://github.com/Shelin-boop/Paint.with.me#build-from-source

EOF
exit 1
